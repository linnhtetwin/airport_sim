{
  "name": "airport-ops-sim",
  "private": true,
  "version": "0.2.0",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "airports": "node scripts/update-airports.mjs",
    "cf:dev": "npm run build && npx --yes wrangler pages dev dist --kv AIRPORT_LAYOUTS",
    "cf:deploy": "npm run build && npx --yes wrangler pages deploy dist --project-name airport-ops-sim"
  },
  "dependencies": {
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@types/three": "^0.186.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "wrangler": "^4.152.0"
  },
  "overrides": {
    "undici": "7.30.1"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "workerd@1.20261019.1": true
  }
}
